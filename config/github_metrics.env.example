# Set these as Jenkins credentials/environment variables; do not commit real secrets.
GITHUB_USERNAME=SanthoshJeeva440
GITHUB_API_URL=https://api.github.com
GITHUB_PER_PAGE=100
GITHUB_MAX_PAGES=100
GITHUB_INCLUDE_PRIVATE=true

# Add as a Jenkins Secret Text credential and bind to GITHUB_TOKEN.
# Fine-grained PAT: read access to profile/account and all target repositories.
# Classic PAT: use a suitable read-only scope for private repositories if needed.
GITHUB_TOKEN=

# Reuse the existing InfluxDB connection settings / Jenkins credentials.
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_BUCKET=qa_metrics
INFLUX_ORG=
INFLUX_TOKEN=
INFLUX_USERNAME=
INFLUX_PASSWORD=
